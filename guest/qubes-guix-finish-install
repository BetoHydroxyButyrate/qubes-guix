#!/bin/sh
# qubes-guix-finish-install — run as root in the Guix INSTALLER, once it says
# the installation is complete and BEFORE rebooting, while the new system is
# still mounted at /mnt. Makes that system a qube before its first boot:
#   1. wraps /mnt/etc/config.scm in (qubes-operating-system ...)
#      (the original is kept as /mnt/etc/config.scm.pre-qubes);
#   2. checks it, then rebuilds /mnt with 'guix system init', using a Guix
#      that includes the qubes channel: the installer's own on the
#      qubes-guix installer ISO (iso/qubes-guix-iso), else one built with
#      guix time-machine.
# The first boot then already has the Qubes agents, its network from QubesDB,
# passwordless sudo, and the qubes channel in /etc/guix/channels.scm.
#
#   sh qubes-guix-finish-install [--template] [-b BRANCH] [--packages "A B"] [TARGET]
#
# --template: the qube is a TemplateVM (qubes-guix-create --template).
# -b BRANCH:  the channel branch to build from and to record (default main).
# --build-commit C: build with Guix at commit C; "installer" is the
#             installer's own commit (substitutes for nearly everything;
#             on the qubes-guix ISO, the Qubes packages are already built),
#             "latest" the current master. Only for this build. Default:
#             the --guix-commit lock if given (so the first update has
#             nothing to rebuild; with --substitutes, the commit your
#             server built), else "installer", or "latest" with --channels
#             (other channels track current Guix).
# --guix-commit C: lock the installed system's Guix at C (#:guix-commit:
#             its /etc/guix/channels.scm pins C). Default: follow the head.
#             "server": EVERY channel at the commits the first
#             --substitutes server last built (its /channel-commits;
#             recorded as #:channel-commits), so the install matches its
#             builds; Guix alone (its /guix-commit) if it doesn't publish
#             /channel-commits.
#             "iso" (the qubes-guix ISO only): Guix and qubes at the
#             ISO's own commits (what its guix was built from, whose Qubes
#             packages its store holds), the other channels at the
#             server's, as "server". For an ISO built from a qubes commit
#             the server hasn't built yet (iso/qubes-guix-iso-remote).
# --packages: extra packages, as #:extra-packages (missing ones are skipped).
# --channels F: extra channels, F holding (channel ...) forms: built with,
#             and recorded as #:extra-channels.
# --substitutes F: extra substitute servers (e.g. a local guix publish or
#             cache), F holding "url URL" and "key (public-key ...)" lines:
#             used, before the default servers, for this build (the keys
#             authorized in the installer), and recorded as
#             #:extra-substitute-urls / #:extra-authorized-keys.
# TARGET:     where the new system is mounted (default /mnt).
#
# qubes-guix-create --finish-install (dom0) fetches this repository into /tmp
# on the installer and prints the command to run.

set -eu

prog=${0##*/}
here=$(cd "$(dirname "$0")" && pwd)
template=0
branch=main
build_commit=default
subs_file=
target=/mnt

say() { printf '\n==> %s\n' "$*"; }
die() { echo "$prog: $*" >&2; exit 1; }

while [ $# -gt 0 ]; do
    case $1 in
        --template) template=1; shift;;
        -b|--branch) [ $# -ge 2 ] || die "$1 needs a value"; branch=$2; shift 2;;
        --packages) [ $# -ge 2 ] || die "$1 needs a value"; QUBES_PACKAGES=$2; export QUBES_PACKAGES; shift 2;;
        --channels) [ $# -ge 2 ] || die "$1 needs a file"
                    [ -f "$2" ] || die "no such file: $2"
                    QUBES_CHANNELS_FILE=$(cd "$(dirname "$2")" && pwd)/${2##*/}
                    export QUBES_CHANNELS_FILE; shift 2;;
        --substitutes) [ $# -ge 2 ] || die "$1 needs a file"
                       [ -f "$2" ] || die "no such file: $2"
                       subs_file=$2; shift 2;;
        --build-commit) [ $# -ge 2 ] || die "$1 needs a value"; build_commit=$2; shift 2;;
        --guix-commit) [ $# -ge 2 ] || die "$1 needs a value"
                       QUBES_GUIX_COMMIT=$2; export QUBES_GUIX_COMMIT; shift 2;;
        -*) die "unknown option $1";;
        *) target=$1; shift;;
    esac
done

[ "$(id -u)" -eq 0 ] || die "run as root (the installer's shell is)"
config=$target/etc/config.scm

# The installer may have unmounted the new system when it finished. If so,
# mount it again: its root is the one ext4/btrfs/xfs partition on the disk
# (and an EFI system partition, if any, goes on /boot/efi).
if [ ! -f "$config" ]; then
    roots=$(lsblk -lnpo NAME,FSTYPE,TYPE | awk '$3=="part" && ($2=="ext4"||$2=="btrfs"||$2=="xfs") {print $1}')
    [ -n "$roots" ] || die "no $config, and no ext4/btrfs/xfs partition to mount.
Has the installation finished? (An encrypted root: open and mount it on
$target yourself, then rerun.)"
    [ "$(echo "$roots" | wc -l)" -eq 1 ] ||
        die "no $config, and several candidate root partitions:
$roots
Mount the right one on $target yourself, then rerun."
    say "Mounting $roots on $target"
    mkdir -p "$target"
    mount "$roots" "$target"
    esp=$(lsblk -lnpo NAME,FSTYPE,TYPE | awk '$3=="part" && $2=="vfat" {print $1}' | head -n1)
    if [ -n "$esp" ] && [ -d "$target/boot/efi" ]; then
        mount "$esp" "$target/boot/efi"
    fi
    [ -f "$config" ] || die "$roots has no etc/config.scm: not the new system?"
fi
# Builds must land on the target's disk, not in the installer's RAM. The
# installer normally still has this running; starting it again is harmless.
# NB: cow-store also bind-mounts $target/tmp over /tmp, hiding whatever was
# in /tmp before. So: start it first, and keep this repository out of /tmp
# (qubes-guix-create clones it to /root).
case $here in
    /tmp/*) die "this repository is under /tmp, which cow-store hides; clone it
elsewhere (e.g. /root/qubes-guix) and run it from there";;
esac
herd start cow-store "$target" >/dev/null 2>&1 || true

# Guix's cache (channel checkouts, the time-machine's builds) on the target's
# disk too, under /tmp (which is now the target's): guix.git alone would
# take a good part of the installer's RAM. The qubes-guix ISO built with
# --offline carries the channels' checkouts: start from those, so nothing
# is fetched (git writes into them, hence a copy).
XDG_CACHE_HOME=${QUBES_GUIX_CACHE:-/tmp/qubes-guix-cache}
export XDG_CACHE_HOME
seed=/etc/qubes-guix-cache
if [ -d "$seed" ] && [ ! -d "$XDG_CACHE_HOME/guix/checkouts" ]; then
    say "Copying the channels' git checkouts from the ISO"
    for e in "$seed"/checkouts/* "$seed"/authentication; do
        [ -e "$e" ] || continue
        rel=${e#"$seed"/}
        mkdir -p "$XDG_CACHE_HOME/guix/$(dirname "$rel")"
        cp -r "$(readlink -f "$e")" "$XDG_CACHE_HOME/guix/$rel"
    done
    chmod -R u+w "$XDG_CACHE_HOME/guix"
fi

for f in wrap-config.guile channels.scm.txt; do
    [ -f "$here/$f" ] || die "$f missing next to $prog"
done

tmp=$(mktemp -d)
trap 'rm -rf "$tmp"' EXIT
channels=$tmp/channels.scm
new=$tmp/config.scm
sed "s/(branch \"main\")/(branch \"$branch\")/" "$here/channels.scm.txt" > "$channels"

# Build with the Guix the installer itself runs (its commit), unless told
# otherwise: CI has built that commit, so the system's packages, and Guix
# itself, come as substitutes rather than local builds. Only the qubes
# channel's packages are built here. (/etc/guix/channels.scm, what later
# pulls follow, stays unpinned.)
# Default: the installer's own Guix, which is fast (substitutes for nearly
# everything). But other channels track current Guix: nonguix, built against
# the 1.5.0 installer's Guix, needs packages (linux-libre-7.2) that Guix
# didn't have yet. So with extra channels, the default is the latest Guix.
# --guix-commit server: ask the first substitute server which commits it
# last built: every channel's (its /channel-commits, "NAME COMMIT" lines),
# or Guix's alone (/guix-commit, from servers that publish only that).
# The qubes-guix ISO built with a substitutes file carries it, as
# /etc/qubes-guix-substitutes, and its guix-daemon already uses those
# servers. Without --substitutes, use them (they're recorded in config.scm,
# so updates use them too); and without a lock, lock to the ISO's own
# commits: the server's builds when the ISO was made, which its store holds.
# The install then builds nothing, and nor does the first update.
iso_subs=/etc/qubes-guix-substitutes
if [ -z "$subs_file" ] && [ -s "$iso_subs" ]; then
    subs_file=$iso_subs
    say "Substitute servers from the ISO: $(sed -n 's/^[[:space:]]*url[[:space:]]\{1,\}//p' "$iso_subs" | xargs)"
    if [ -z "${QUBES_GUIX_COMMIT:-}" ] && [ -z "${QUBES_CHANNEL_COMMITS:-}" ] &&
       [ -z "${QUBES_CHANNELS_FILE:-}" ]; then
        iso_commits=$(guix describe 2>/dev/null | awk '
            NF == 2 && $1 !~ /:$/ { name = $1 }
            $1 == "commit:" && (name == "guix" || name == "qubes") { print name, $2 }')
        if [ "$(printf '%s\n' "$iso_commits" | grep -c .)" = 2 ]; then
            QUBES_CHANNEL_COMMITS=$iso_commits
            export QUBES_CHANNEL_COMMITS
            say "Locking to the ISO's commits (qubes-guix-update --guix-commit
server moves it to the server's latest build, --head to the head):
$iso_commits"
        fi
    fi
fi

# --guix-commit iso: the ISO's guix and qubes commits; the other channels
# from the server, if there is one (then as "server", below).
iso_lock=0
if [ "${QUBES_GUIX_COMMIT:-}" = iso ]; then
    iso_lock=1
    iso_commits=$(guix describe 2>/dev/null | awk '
        NF == 2 && $1 !~ /:$/ { name = $1 }
        $1 == "commit:" && (name == "guix" || name == "qubes") { print name, $2 }')
    [ "$(printf '%s\n' "$iso_commits" | grep -c .)" = 2 ] ||
        die "--guix-commit iso: this installer's guix has no qubes channel
(not the qubes-guix ISO?)"
    if [ -n "$subs_file" ]; then
        QUBES_GUIX_COMMIT=server
    else
        unset QUBES_GUIX_COMMIT
    fi
fi

server_commits=
if [ "${QUBES_GUIX_COMMIT:-}" = server ]; then
    [ -n "$subs_file" ] || die "--guix-commit server needs --substitutes"
    server=$(sed -n 's/^[[:space:]]*url[[:space:]]\{1,\}//p' "$subs_file" | head -n1)
    server=${server%/}
    file=$(guix download "$server/channel-commits" 2>/dev/null | head -n1) || file=
    if [ -n "$file" ] && [ -f "$file" ]; then
        server_commits=$(grep -v '^[[:space:]]*$' "$file")
        printf '%s\n' "$server_commits" | while read -r name c rest; do
            case $c in
                *[!0-9a-f]*|'') die "$server/channel-commits: '$name $c' isn't NAME COMMIT";;
            esac
            [ ${#c} -eq 40 ] && [ -z "$rest" ] ||
                die "$server/channel-commits: '$name $c $rest' isn't NAME COMMIT"
        done || exit 1
        guix_lock=$(printf '%s\n' "$server_commits" | awk '$1 == "guix" {print $2; exit}')
        [ -n "$guix_lock" ] || die "$server/channel-commits: no guix line"
        # Recorded as #:channel-commits (wrap-config.guile), which has Guix's
        # too: no separate #:guix-commit.
        unset QUBES_GUIX_COMMIT
        QUBES_CHANNEL_COMMITS=$server_commits
        export QUBES_CHANNEL_COMMITS
        say "$server last built these channels: locking to them
$server_commits"
    else
        file=$(guix download "$server/guix-commit" 2>/dev/null | head -n1) || file=
        [ -n "$file" ] && [ -f "$file" ] ||
            die "couldn't fetch $server/channel-commits or /guix-commit (is the server up?)"
        QUBES_GUIX_COMMIT=$(tr -d ' \n' < "$file")
        case $QUBES_GUIX_COMMIT in
            *[!0-9a-f]*|'') die "$server/guix-commit: not a commit hash";;
        esac
        export QUBES_GUIX_COMMIT
        guix_lock=$QUBES_GUIX_COMMIT
        say "$server last built Guix $QUBES_GUIX_COMMIT (it publishes no
/channel-commits): locking Guix alone to it"
    fi
fi
if [ "$iso_lock" = 1 ]; then
    server_commits=$(printf '%s\n%s\n' "$iso_commits" \
        "$(printf '%s\n' "$server_commits" | awk '$1 != "guix" && $1 != "qubes"')" | grep .)
    unset QUBES_GUIX_COMMIT
    QUBES_CHANNEL_COMMITS=$server_commits
    export QUBES_CHANNEL_COMMITS
    guix_lock=$(printf '%s\n' "$iso_commits" | awk '$1 == "guix" {print $2; exit}')
    say "Locking guix and qubes to the ISO's commits$( [ -n "$subs_file" ] && echo ', the others to the server'"'"'s'):
$server_commits"
fi
[ -n "${guix_lock:-}" ] || guix_lock=${QUBES_GUIX_COMMIT:-}
if [ "$build_commit" = default ] && [ -n "$guix_lock" ]; then
    build_commit=$guix_lock
    say "Building with Guix at the commit it's locked to ($build_commit)"
fi
if [ "$build_commit" = default ]; then
    if [ -n "${QUBES_CHANNELS_FILE:-}" ]; then
        build_commit=latest
        say "Extra channels: building with the latest Guix, which they track (slower)"
    else
        build_commit=installer
    fi
fi
# A field (branch, commit) of channel $1 in the running Guix ('guix
# describe'); empty if it doesn't have that channel.
described() {
    guix describe 2>/dev/null | awk -v ch="$1" -v f="$2:" '
        NF == 2 && $1 !~ /:$/ { name = $1 }
        $1 == f && name == ch { print $2; exit }'
}
installer_commit=$(described guix commit)
case $build_commit in
    installer) build_commit=$installer_commit;;
    latest) build_commit=;;
esac

# The qubes-guix ISO: the installer's own guix already includes the qubes
# channel, and its store has the Qubes packages built with it. Build with it
# directly (no time-machine: no Guix to build, nor the agents) when it's
# what this build asks for: Guix at the installer's commit, the qubes
# channel on the same branch (and at the server's commit, if locked to
# one), and no extra channels.
iso_guix=0
iso_qubes=$(described qubes commit)
if [ -n "$iso_qubes" ] && [ -n "$build_commit" ] &&
   [ "$build_commit" = "$installer_commit" ] &&
   [ "$(described qubes branch)" = "$branch" ] &&
   [ -z "${QUBES_CHANNELS_FILE:-}" ]; then
    server_qubes=$(printf '%s\n' "$server_commits" | awk '$1 == "qubes" {print $2; exit}')
    if [ -z "$server_qubes" ] || [ "$server_qubes" = "$iso_qubes" ]; then
        iso_guix=1
    fi
fi
if [ "$iso_guix" = 1 ]; then
    say "Building with the installer's own Guix ($installer_commit), which has the
qubes channel ($branch, $iso_qubes): the Qubes packages are already built"
elif [ -n "$build_commit" ]; then
    case $build_commit in
        *[!0-9a-f]*) die "--build-commit: '$build_commit' isn't a commit hash";;
    esac
    say "Building with Guix at commit $build_commit"
    sed "s/^       %default-channels)\$/       (map (lambda (c)\\
              (if (eq? (channel-name c) 'guix)\\
                  (channel (inherit c) (commit \"$build_commit\"))\\
                  c))\\
            %default-channels))/" "$channels" > "$channels.pinned"
    grep -q "$build_commit" "$channels.pinned" || die "couldn't pin Guix in $channels"
    mv "$channels.pinned" "$channels"
else
    say "Building with the latest Guix (unpinned): slow, it builds Guix itself"
fi

# Extra channels: built with now (so #:extra-packages can name their
# packages, and the system's guix includes them) and recorded in the config
# as #:extra-channels (QUBES_CHANNELS_FILE, read by wrap-config.guile).
if [ -n "${QUBES_CHANNELS_FILE:-}" ]; then
    say "Extra channels from $QUBES_CHANNELS_FILE"
    { echo '(append'; cat "$channels"; echo; echo '(list'
      cat "$QUBES_CHANNELS_FILE"; echo; echo '))'; } > "$channels.extra"
    mv "$channels.extra" "$channels"
fi

# The server's commits for the channels other than Guix (whose commit the
# build uses is $build_commit, above): build with them too, so the qubes,
# nonguix... packages come from the server.
if [ -n "$server_commits" ]; then
    pins=$(printf '%s\n' "$server_commits" |
           awk '$1 != "guix" {printf "(%s . \"%s\") ", $1, $2}')
    { printf '%s\n' "(let ((pins '($pins)))" \
          "  (map (lambda (c)" \
          "         (let ((pin (assq-ref pins (channel-name c))))" \
          "           (if pin (channel (inherit c) (commit pin)) c)))"
      cat "$channels"
      printf '%s\n' "))"
    } > "$channels.locked"
    mv "$channels.locked" "$channels"
fi

# Extra substitute servers: authorized in the installer's daemon and used,
# ahead of the default ones, for the builds below; recorded in config.scm
# (QUBES_SUBSTITUTE_URLS/KEYS, read by wrap-config.guile).
subs=
if [ -n "$subs_file" ]; then
    QUBES_SUBSTITUTE_URLS=$(sed -n 's/^[[:space:]]*url[[:space:]]\{1,\}//p' "$subs_file" | xargs)
    QUBES_SUBSTITUTE_KEYS=$(sed -n 's/^[[:space:]]*key[[:space:]]\{1,\}//p' "$subs_file")
    export QUBES_SUBSTITUTE_URLS QUBES_SUBSTITUTE_KEYS
    [ -n "$QUBES_SUBSTITUTE_URLS" ] || die "$subs_file: no 'url ...' line"
    say "Substitute servers first: $QUBES_SUBSTITUTE_URLS"
    printf '%s\n' "$QUBES_SUBSTITUTE_KEYS" > "$tmp/keys"
    while IFS= read -r k; do
        [ -n "$k" ] || continue
        printf '%s\n' "$k" | guix archive --authorize ||
            die "couldn't authorize the key: $k"
    done < "$tmp/keys"
    subs="$QUBES_SUBSTITUTE_URLS https://bordeaux.guix.gnu.org https://ci.guix.gnu.org"
fi

say "Wrapping $config"
set +e
QUBES_IN=$config QUBES_OUT=$new QUBES_TEMPLATE=$template QUBES_BRANCH=$branch \
    guix repl -- "$here/wrap-config.guile"
status=$?
set -e
case $status in
    0) ;;
    3) cp "$config" "$new";;
    *) die "couldn't wrap $config (unchanged)";;
esac

# The installer's Guix trusts only its own channels, so the time-machine
# warned "channel 'beto' is not trusted" for each extra channel (only a
# warning, for a local channels file). These are the channels this install
# was given: trust them, for this installer's root only (and not over a
# trusted-channels.scm of its own). Introductions are still checked.
guix_config=${XDG_CONFIG_HOME:-${HOME:-/root}/.config}/guix
if [ "$iso_guix" != 1 ] && [ ! -e "$guix_config/trusted-channels.scm" ]; then
    mkdir -p "$guix_config"
    cp "$channels" "$guix_config/trusted-channels.scm"
fi

# guix, with the qubes channel: the installer's, or one time-machine builds.
qguix() {
    if [ "$iso_guix" = 1 ]; then
        guix "$@"
    else
        guix time-machine ${subs:+"--substitute-urls=$subs"} -C "$channels" -- "$@"
    fi
}

if [ "$iso_guix" = 1 ]; then
    say "Checking it with the qubes channel ($branch)"
else
    say "Checking it with the qubes channel ($branch). The first run builds a Guix: slow."
fi
if ! qguix system build ${subs:+"--substitute-urls=$subs"} --dry-run "$new" >/dev/null; then
    cp "$new" /root/config.scm.qubes-failed
    die "the wrapped configuration doesn't evaluate; $config is unchanged.
The attempted version is in /root/config.scm.qubes-failed"
fi

[ -e "$config.pre-qubes" ] || cp "$config" "$config.pre-qubes"
cp "$new" "$config"

say "Rebuilding $target as a qube (guix system init; builds the Qubes agents)"
# 'guix system init' copies the system from this installer's store to
# $target. Read from the ISO as an HVM's emulated CD, a stretch of it has
# been seen to come back wrong once and then stay wrong in the page cache
# (a fresh read was fine). A compressed (zisofs) file then fails to read:
# "Input/output error", and the copy stops. An uncompressed one would be
# copied wrong without a word. So: after a failure, drop the page cache and
# run it again (it copies what's still missing, redoing a partial item); then
# check the copy (below).
attempt=1
until qguix system init ${subs:+"--substitute-urls=$subs"} "$config" "$target"; do
    [ "$attempt" -lt 3 ] || die "guix system init failed $attempt times; see the errors above"
    attempt=$((attempt + 1))
    say "guix system init failed; dropping the page cache and trying again ($attempt of 3)"
    sync
    echo 3 > /proc/sys/vm/drop_caches
done

# The check: $target's database records each copied item's hash as computed
# from the copy; this installer's records the same item's hash from when it
# was built (the ISO's store) or fetched. Any difference is a corrupt copy.
say "Checking the copy against the installer's store"
cat > "$tmp/verify.scm" <<'VERIFY'
(use-modules (sqlite3) (ice-9 match))
(define (hashes file)
  (let* ((db (sqlite-open file SQLITE_OPEN_READONLY))
         (st (sqlite-prepare db "SELECT path, hash FROM ValidPaths"))
         (table (make-hash-table)))
    (let loop ()
      (match (sqlite-step st)
        (#(path hash) (hash-set! table path hash) (loop))
        (_ #t)))
    (sqlite-finalize st)
    (sqlite-close db)
    table))
(match (command-line)
  ((_ source target)
   (let* ((src (hashes source))
          (dst (hashes target))
          (bad (hash-fold (lambda (path hash bad)
                            (let ((expected (hash-ref src path)))
                              (if (and expected (not (string=? expected hash)))
                                  (cons path bad)
                                  bad)))
                          '() dst)))
     (format #t "~a items copied, ~a checked against this installer's store~%"
             (hash-count (const #t) dst)
             (hash-count (lambda (path hash) (hash-ref src path)) dst))
     (for-each (lambda (path) (format #t "CORRUPT: ~a~%" path)) bad)
     (exit (if (null? bad) 0 1)))))
VERIFY
guix repl -- "$tmp/verify.scm" /var/guix/db/db.sqlite "$target/var/guix/db/db.sqlite" ||
    die "the copy in $target differs from this installer's store (above): a
read from the installer's CD came back wrong. Install again (with
qubes-guix-create: --force)."

# Root's Guix cache on the installed system: the channels' git checkouts,
# now holding the commits this system was built from, and the authentication
# cache. The first 'guix pull' (qubes-guix-update -r, as root) is locked to
# those commits, so it finds them here and fetches nothing, rather than
# cloning guix.git through the Qubes updates proxy.
if [ -d "$XDG_CACHE_HOME/guix/checkouts" ]; then
    say "Giving the installed system the channels' git checkouts"
    mkdir -p "$target/root/.cache/guix"
    for e in "$XDG_CACHE_HOME/guix/checkouts" "$XDG_CACHE_HOME/guix/authentication"; do
        [ -e "$e" ] || continue
        rm -rf "$target/root/.cache/guix/${e##*/}"
        cp -a "$e" "$target/root/.cache/guix/" ||
            echo "$prog: warning: couldn't copy $e: the first guix pull will fetch it" >&2
    done
fi

cat <<EOF

Done: $target is now a Qubes qube. Reboot (back in the installer: Ctrl+Alt+F1,
or 'reboot' here). From the first boot on:
  - network, qrexec and the GUI agent come up by themselves;
  - 'guix pull' includes the qubes channel ($branch), from /etc/guix/channels.scm;
    pull before your first 'sudo guix system reconfigure /etc/config.scm'.
EOF
if [ "$template" = 1 ]; then
    cat <<EOF
  - as a template: its first start moves /home to the private volume.
    Create AppVMs in dom0 as the README says (virt_mode hvm, memory set).
EOF
fi
