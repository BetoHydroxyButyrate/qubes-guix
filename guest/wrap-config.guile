;;; guest/wrap-config.guile — wrap the last form of a Guix system configuration
;;; in (qubes-operating-system ...). Run by qubes-guix-setup through
;;; `guix repl`; plain Guile works too.
;;;
;;;   QUBES_IN=/etc/config.scm QUBES_OUT=/tmp/new.scm guix repl -- wrap-config.guile
;;;
;;; With QUBES_TEMPLATE=1 the wrap gets #:template? #t (a Qubes TemplateVM);
;;; an existing (qubes-operating-system ...) without it gets it added.
;;; With QUBES_BRANCH=B (other than main), a new wrap gets
;;; #:channel-branch "B": the branch of the system-wide qubes channel.
;;; With QUBES_PACKAGES="git emacs", it gets #:extra-packages '("git" "emacs")
;;; (also added to an existing wrap that has none).
;;; With QUBES_GUIX_COMMIT=C, #:guix-commit "C" (likewise): the commit the
;;; system's channels pin Guix at. An existing #:guix-commit is left alone;
;;; qubes-guix-update --guix-commit changes it.
;;; With QUBES_CHANNEL_COMMITS="NAME COMMIT" lines (a substitute server's
;;; /channel-commits), #:channel-commits '((NAME . "COMMIT") ...): added to a
;;; new wrap or one without it, and REPLACED in one that has it (then nothing
;;; else is changed). Set but empty: #:channel-commits '() (unlocked).
;;; With QUBES_PRINT=follow-head, print the channel names of #:follow-head
;;; (space-separated; "all" for #t; nothing if none), change nothing, and
;;; need no QUBES_OUT. With QUBES_PRINT=channel-commits, likewise print
;;; #:channel-commits, one "NAME COMMIT" line per channel.
;;; With QUBES_CHANNELS_FILE=F, a file of (channel ...) forms, #:extra-channels
;;; (list <F's text>) (likewise; an existing one is left alone).
;;; With QUBES_SUBSTITUTE_URLS="URL ..." (and QUBES_SUBSTITUTE_KEYS, the
;;; servers' public keys, one per line), #:extra-substitute-urls and
;;; #:extra-authorized-keys (likewise).
;;;
;;; The edit is textual (the file is never re-printed), so comments and
;;; layout survive. Exit status: 0 wrapped, 3 already a qube, 1 error.
;;;
;;; Not named .scm on purpose: Guix compiles (and first loads) every .scm in
;;; a channel, and loading this script would exit and fail guix pull.

(use-modules (ice-9 textual-ports)
             (ice-9 rdelim)
             (ice-9 match)
             (srfi srfi-1))

;; Register #~ #$ reader syntax when Guix is around, so configs that use
;; gexps can be read.
(false-if-exception (resolve-module '(guix gexp)))

(define (fail fmt . args)
  (apply format (current-error-port) (string-append "wrap-config: " fmt "~%")
         args)
  (exit 1))

(define in  (or (getenv "QUBES_IN")  (fail "QUBES_IN not set")))
(define print-request                   ; QUBES_PRINT=follow-head
  (let ((p (getenv "QUBES_PRINT")))
    (and p (not (string-null? p)) p)))
(define out (or (getenv "QUBES_OUT")
                (and print-request "/dev/null")
                (fail "QUBES_OUT not set")))

(define text (call-with-input-file in get-string-all))

;; Read every top-level form, remembering where each ends.
(define forms+ends
  (call-with-input-string text
    (lambda (port)
      (let loop ((acc '()))
        (let ((form (catch #t
                      (lambda () (read port))
                      (lambda (key . args)
                        (fail "~a doesn't read as Scheme: ~a ~s" in key args)))))
          (if (eof-object? form)
              (reverse acc)
              (loop (cons (cons form (ftell port)) acc))))))))

(when (null? forms+ends)
  (fail "~a is empty" in))

(define (mentions? symbols tree)
  (let walk ((x tree))
    (cond ((pair? x) (or (walk (car x)) (walk (cdr x))))
          ((vector? x) (walk (vector->list x)))
          (else (memq x symbols)))))

(define template? (equal? (getenv "QUBES_TEMPLATE") "1"))
(define branch
  (let ((b (getenv "QUBES_BRANCH")))
    (and b (not (string-null? b)) (not (string=? b "main")) b)))
(define packages                        ; QUBES_PACKAGES="git emacs"
  (let ((p (getenv "QUBES_PACKAGES")))
    (if p (filter (lambda (x) (not (string-null? x))) (string-split p #\space)) '())))
(define packages-keyword
  (format #f "\n #:extra-packages '~s" packages))
(define guix-commit                     ; QUBES_GUIX_COMMIT=<hash>
  (let ((c (getenv "QUBES_GUIX_COMMIT")))
    (and c (not (string-null? c)) c)))
(define guix-commit-keyword
  (format #f "\n #:guix-commit ~s" guix-commit))
(define channel-commits                 ; QUBES_CHANNEL_COMMITS: "NAME COMMIT" lines
  ;; #f if unset; '() if set but empty (unlock).
  (let ((c (getenv "QUBES_CHANNEL_COMMITS")))
    (and c
         (filter-map
          (lambda (line)
            (match (filter (lambda (w) (not (string-null? w)))
                           (string-split (string-trim-both line) #\space))
              (() #f)
              ((name commit)
               (unless (and (>= (string-length commit) 7)
                            (string-every (char-set-union char-set:digit
                                                          (string->char-set "abcdef"))
                                          commit))
                 (fail "QUBES_CHANNEL_COMMITS: ~s isn't a commit hash" commit))
               (cons (string->symbol name) commit))
              (_ (fail "QUBES_CHANNEL_COMMITS: expected \"NAME COMMIT\", got ~s"
                       line))))
          (string-split c #\newline)))))
(define channel-commits-value           ; the value's text
  (and channel-commits
       (if (null? channel-commits)
           "'()"
           (string-append
            "'("
            (string-join (map (lambda (p) (format #f "(~a . ~s)" (car p) (cdr p)))
                              channel-commits)
                         "\n   ")
            ")"))))
(define channel-commits-keyword
  (and channel-commits (pair? channel-commits)
       (string-append "\n #:channel-commits\n " channel-commits-value)))
(define channels-text                   ; QUBES_CHANNELS_FILE=extra.scm
  ;; The file's text, kept as written (comments too), after checking that
  ;; its forms are all (channel ...).
  (let ((file (getenv "QUBES_CHANNELS_FILE")))
    (and file (not (string-null? file))
         (let ((text (call-with-input-file file get-string-all)))
           (call-with-input-string text
             (lambda (port)
               (let loop ((n 0))
                 (let ((form (read port)))
                   (cond ((eof-object? form)
                          (if (zero? n) #f text))
                         ((and (pair? form) (eq? (car form) 'channel))
                          (loop (+ n 1)))
                         (else
                          (fail "~a: expected only (channel ...) forms, found ~s"
                                file form)))))))))))
(define channels-keyword
  (and channels-text
       ;; The ")" on a line of its own: the file may end with a comment.
       (string-append "\n #:extra-channels\n (list\n"
                      (string-trim-right channels-text)
                      "\n )")))
;; QUBES_SUBSTITUTE_URLS="http://a http://a/bordeaux", QUBES_SUBSTITUTE_KEYS:
;; one "(public-key ...)" per line.
(define (non-empty-strings lst)
  (filter (lambda (x) (not (string-null? x))) (map string-trim-both lst)))
(define substitute-urls
  (let ((u (getenv "QUBES_SUBSTITUTE_URLS")))
    (if u (non-empty-strings (string-split u #\space)) '())))
(define substitute-keys
  (let ((k (getenv "QUBES_SUBSTITUTE_KEYS")))
    (if k (non-empty-strings (string-split k #\newline)) '())))
(define substitutes-keyword
  (if (null? substitute-urls)
      #f
      (string-append
       (format #f "\n #:extra-substitute-urls '~s" substitute-urls)
       (if (null? substitute-keys)
           ""
           (string-append "\n #:extra-authorized-keys\n (list"
                          (string-concatenate
                           (map (lambda (k) (format #f "\n  ~s" k))
                                substitute-keys))
                          ")")))))
(define new-keywords
  ;; Appended inside a new (qubes-operating-system ...) wrap.
  (string-append (if template? "\n #:template? #t" "")
                 (if branch (format #f "\n #:channel-branch ~s" branch) "")
                 (if guix-commit guix-commit-keyword "")
                 (or channel-commits-keyword "")
                 (or channels-keyword "")
                 (or substitutes-keyword "")
                 (if (null? packages) "" packages-keyword)))
(define last-form (car (last forms+ends)))
(define last-end  (cdr (last forms+ends)))
(define prev-end
  (match (reverse forms+ends)
    ((_ (_ . end) . _) end)
    (_ 0)))

;; Start of the last form: skip whitespace and ; comments after the
;; previous form.
(define last-start
  (let loop ((i prev-end))
    (cond ((>= i last-end) (fail "can't locate the last form in ~a" in))
          ((char-whitespace? (string-ref text i)) (loop (+ i 1)))
          ((char=? (string-ref text i) #\;)
           (let ((nl (string-index text #\newline i)))
             (loop (if nl (+ nl 1) last-end))))
          ((char=? (string-ref text i) #\() i)
          (else (fail "unexpected text before the last form of ~a" in)))))

;; The (channel ...) forms of #:extra-channels need (guix channels).
(define channels-modules
  ";; For the (channel ...) forms of #:extra-channels.
(use-modules (guix channels))

")

;; QUBES_PRINT=follow-head or channel-commits: report it, change nothing.
(define (quoted-names x)
  (match x
    (('quote (? list? names)) names)
    (('list . items)
     (map (match-lambda (('quote (? symbol? n)) n)
                        (other (fail "#:follow-head: can't read ~s" other)))
          items))
    (_ (fail "#:follow-head: expected #t or '(name ...), got ~s" x))))
(define (print-channel-commits x)
  (match x
    (('quote (? list? alist))
     (for-each (match-lambda
                 (((? symbol? name) . (? string? commit))
                  (format #t "~a ~a~%" name commit))
                 (other (fail "#:channel-commits: can't read ~s" other)))
               alist))
    (_ (fail "#:channel-commits: expected '((name . \"commit\") ...), got ~s" x))))
(when print-request
  (cond
   ((string=? print-request "follow-head")
    (match last-form
      (('qubes-operating-system . rest)
       (match (memq #:follow-head rest)
         ((_ #t . _) (display "all"))
         ((_ value . _) (display (string-join (map symbol->string
                                                   (quoted-names value))
                                              " ")))
         (_ #t)))
      (_ #t))
    (newline))
   ((string=? print-request "channel-commits")
    (match last-form
      (('qubes-operating-system . rest)
       (match (memq #:channel-commits rest)
         ((_ value . _) (print-channel-commits value))
         (_ #t)))
      (_ #t)))
   (else
    (fail "QUBES_PRINT: follow-head or channel-commits, not ~s" print-request)))
  (exit 0))

;; The elements of the form that starts (with its "(") at START: a list of
;; (DATUM START . END), END just past the datum. Positions are ftell's, as
;; for forms+ends.
(define (skip-blank port)
  (let loop ()
    (let ((c (peek-char port)))
      (cond ((eof-object? c) (ftell port))
            ((char-whitespace? c) (read-char port) (loop))
            ((char=? c #\;) (read-line port) (loop))
            (else (ftell port))))))
(define (form-elements start)
  (call-with-input-string text
    (lambda (port)
      (seek port (+ start 1) SEEK_SET)
      (let loop ((acc '()))
        (let ((pos (skip-blank port)))
          (if (let ((c (peek-char port)))
                (or (eof-object? c) (char=? c #\))))
              (reverse acc)
              (let* ((datum (read port))
                     (end (ftell port)))
                (loop (cons (cons* datum pos end) acc)))))))))

;; QUBES_CHANNEL_COMMITS on a wrap that already has #:channel-commits:
;; replace its value (only that), keeping everything else as written.
(match last-form
  (('qubes-operating-system . rest)
   (when (and channel-commits (memq #:channel-commits rest))
     (let loop ((elts (form-elements last-start)))
       (cond ((or (null? elts) (null? (cdr elts)))
              (fail "couldn't find #:channel-commits' value in ~a" in))
             ((eq? (car (car elts)) #:channel-commits)
              (let ((vstart (cadr (cadr elts)))
                    (vend   (cddr (cadr elts))))
                (call-with-output-file out
                  (lambda (port)
                    (put-string port (substring text 0 vstart))
                    (put-string port channel-commits-value)
                    (put-string port (substring text vend))))
                (format #t "Set #:channel-commits in ~a -> ~a~%" in out)
                (exit 0)))
             (else (loop (cdr elts)))))))
  (_ #t))

(when (any (lambda (f) (mentions? '(qubes-operating-system
                                    qubes-guest-service-type)
                                  (car f)))
           forms+ends)
  (match last-form
    ;; Already wrapped: add what was asked for and isn't there yet
    ;; (#:template? #t, #:extra-packages) just inside the wrap's closing
    ;; paren. An existing #:extra-packages list is left as it is: edit it.
    (('qubes-operating-system . rest)
     (=> next)
     (let ((additions
            (string-append
             (if (and template? (not (memq #:template? rest)))
                 "\n #:template? #t" "")
             (if (and guix-commit (not (memq #:guix-commit rest)))
                 guix-commit-keyword "")
             (if (and channel-commits-keyword
                      (not (memq #:channel-commits rest)))
                 channel-commits-keyword "")
             (if (and channels-keyword (not (memq #:extra-channels rest)))
                 channels-keyword "")
             (if (and substitutes-keyword
                      (not (memq #:extra-substitute-urls rest)))
                 substitutes-keyword "")
             (if (and (pair? packages) (not (memq #:extra-packages rest)))
                 packages-keyword ""))))
       (when (string-null? additions) (next))
       (call-with-output-file out
         (lambda (port)
           (if (and channels-keyword (not (memq #:extra-channels rest)))
               (begin
                 (put-string port (substring text 0 last-start))
                 (put-string port channels-modules)
                 (put-string port (substring text last-start (- last-end 1))))
               (put-string port (substring text 0 (- last-end 1))))
           (put-string port additions)
           (put-string port ")")
           (put-string port (substring text last-end))
           (unless (string-suffix? "\n" text) (newline port))))
       (format #t "Added~a to ~a -> ~a~%"
               (string-map (lambda (c) (if (char=? c #\newline) #\space c))
                           additions)
               in out)
       (exit 0)))
    (_
     (when (and template? (not (mentions? '(#:template?) last-form)))
       (fail "~a already uses the Qubes service, but not as a template;
add #:template? #t to its (qubes-operating-system ...) form by hand" in))
     (format #t "~a already uses the Qubes service; nothing to do.~%" in)
     (exit 3))))
(match last-form
  (('operating-system . _) #t)
  (_ (fail "the last form of ~a is not (operating-system ...); wrap it by hand:
  (qubes-operating-system <your operating-system>)" in)))

(call-with-output-file out
  (lambda (port)
    (put-string port (substring text 0 last-start))
    (put-string port (string-append ";; Added by qubes-guix-setup: make this system a Qubes qube.
;; See https://github.com/BetoHydroxyButyrate/qubes-guix (qubes/system.scm).
(use-modules (qubes system)" (if channels-keyword " (guix channels)" "") ")

(qubes-operating-system
"))
    (put-string port (substring text last-start last-end))
    (put-string port new-keywords)
    (put-string port ")")
    (put-string port (substring text last-end))
    (unless (string-suffix? "\n" text) (newline port))))

(format #t "Wrapped ~a -> ~a~%" in out)
