#!/bin/sh
# qubes-guix-monitor — run a command (an install, an update) with a monitor
# around it, as root: on the console of the stock Guix installer, or by
# qubes-guix-update from a terminal.
#
#   qubes-guix-monitor COMMAND [ARG...]
#
# A tmux session: COMMAND above, its output also appended to a log; htop
# below left, and below right either the network traffic per remote
# address (qubes-guix-netacct watch) or the store items being built or
# fetched (from 'guix processes'). What the qubes-guix ISO shows on its
# tty1. Without tmux or htop (the stock ISO, an installed qube) they come
# from 'guix shell' first. When COMMAND ends (unless it powers the machine
# off), its pane says how, and a shell follows there. Ctrl-b d leaves tmux;
# running qubes-guix-monitor again goes back to a session still running its
# COMMAND, and replaces one whose COMMAND has ended (its output is in the
# log). The socket is under /run, so a bare 'tmux attach' won't find it:
# TMUX_TMPDIR=/run tmux attach -t SESSION.
#
# Env: QUBES_GUIX_MONITOR_SESSION  tmux session name     (qubes-guix)
#      QUBES_GUIX_MONITOR_LOG      COMMAND's log  (/root/qubes-guix-monitor.log)
#      QUBES_GUIX_MONITOR_RIGHT    netacct or builds      (netacct)
#
# Without tmux (guix shell failed: no network?), COMMAND just runs.

set -u
here=$(cd "$(dirname "$0")" && pwd)
session=${QUBES_GUIX_MONITOR_SESSION:-qubes-guix}
log=${QUBES_GUIX_MONITOR_LOG:-/root/qubes-guix-monitor.log}
right=${QUBES_GUIX_MONITOR_RIGHT:-netacct}

# The "builds" pane: the store items guix-daemon holds a lock on, i.e. is
# building or fetching, every 3 seconds.
if [ "${1:-}" = --watch-builds ]; then
    while :; do
        rows=$(stty size 2>/dev/null | cut -d' ' -f1)
        case $rows in ''|*[!0-9]*) rows=24;; esac
        items=$(guix processes 2>/dev/null |
                sed -n 's|^LockHeld: /gnu/store/[0-9a-z]*-\(.*\)\.lock$|\1|p' |
                sed 's/\.drv$//' | sort -u)
        n=$(printf '%s' "$items" | grep -c .)
        printf '\033[H\033[2J%s: %s being built or fetched\n\n%s\n' \
            "$(date +%T)" "$n" "$(printf '%s\n' "$items" | head -n $((rows - 4)))"
        sleep 3
    done
fi
# The socket under /run: cow-store hides /tmp once an install starts.
export TMUX_TMPDIR=/run

if ! command -v tmux >/dev/null 2>&1 || ! command -v htop >/dev/null 2>&1; then
    if [ -z "${QUBES_GUIX_MONITOR_SHELL:-}" ] && command -v guix >/dev/null 2>&1; then
        echo "qubes-guix-monitor: fetching tmux, htop and nftables (guix shell)..."
        QUBES_GUIX_MONITOR_SHELL=1 exec guix shell -q tmux htop nftables -- \
            sh "$0" "$@"
    fi
    echo "qubes-guix-monitor: no tmux or htop: running without the monitor" >&2
    exec "$@"
fi

if tmux has-session -t "$session" 2>/dev/null; then
    if [ -z "$(tmux show-options -qv -t "$session" @done)" ]; then
        echo "qubes-guix-monitor: '$session' is still running $(tmux show-options -qv -t "$session" @command); attaching to it (not running $*)" >&2
        sleep 2
        exec tmux attach-session -t "$session"
    fi
    tmux kill-session -t "$session"
fi

# COMMAND's pane: its output to the pane and the log, then how it ended,
# then a shell (so a failure stays readable, and fixable).
# shellcheck disable=SC2016  # expanded by that pane's shell
run='
log=$1; shift
echo "== $(date): $*" >> "$log"
{ "$@"; echo $? > "$log.status"; } 2>&1 | tee -a "$log"
st=$(cat "$log.status" 2>/dev/null || echo "?")
echo
tmux set-option @done "$st" 2>/dev/null
echo "== exited $st ($(date +%T)). Its output: $log. A shell follows (Ctrl-b d leaves tmux)."
exec "${SHELL:-sh}" -i'

tmux -f /dev/null new-session -d -s "$session" -x 200 -y 50 \
    sh -c "$run" qubes-guix-monitor "$log" "$@"
tmux set-option -t "$session" @command "$*" >/dev/null
tmux set-option -t "$session" status-right "C-b d: leave tmux " >/dev/null
tmux set-option -t "$session" status-right-length 40 >/dev/null
tmux split-window -t "$session:0.0" -v -l 40% htop
if [ "$right" = builds ]; then
    tmux split-window -t "$session:0.1" -h -l 50% sh "$here/qubes-guix-monitor" --watch-builds
else
    tmux split-window -t "$session:0.1" -h -l 50% sh "$here/qubes-guix-netacct" watch
fi
# Keep the proportions when the terminal is resized (split-window's sizes
# are fixed once made: only the top pane would grow or shrink): COMMAND
# 60% of the height, the two below half the width each.
tmux set-hook -t "$session" window-resized \
    "resize-pane -t $session:0.0 -y 60% ; resize-pane -t $session:0.1 -x 50%"
tmux select-pane -t "$session:0.0"
exec tmux attach-session -t "$session"
